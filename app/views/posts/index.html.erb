<div class="max-w-6xl mx-auto px-4 py-10">

  <%# ── ヘッダー ── %>
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-10">
    <div>
      <p class="text-xs tracking-[0.3em] text-amber-500 uppercase mb-1">vinyl collection</p>
      <h1 class="text-4xl font-black tracking-tight text-white">MY COLLECTION</h1>
    </div>
    <%= link_to new_post_path, class: "inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-black font-bold px-5 py-2.5 text-sm tracking-wide transition-colors" do %>
      <span class="text-base leading-none">＋</span> 新しい盤を登録する
    <% end %>
  </div>

  <%# ── 検索フォーム ── %>
  <div class="bg-zinc-900 border border-zinc-800 p-5 mb-10">
    <%= form_with url: posts_path, method: :get, local: true, class: "flex flex-col sm:flex-row gap-3" do |f| %>
      <%= f.text_field :search,
            value: params[:search],
            placeholder: "アーティスト・タイトルで検索...",
            class: "flex-[2] bg-zinc-800 border border-zinc-700 text-zinc-100 placeholder-zinc-500 px-4 py-2.5 text-sm focus:outline-none focus:border-amber-500 transition-colors" %>
      <%= f.select :genre, Post::GENRES,
            { include_blank: "全ジャンル", selected: params[:genre] },
            { class: "flex-1 bg-zinc-800 border border-zinc-700 text-zinc-100 px-4 py-2.5 text-sm focus:outline-none focus:border-amber-500 transition-colors" } %>
      <div class="flex items-center gap-3">
        <%= f.submit "検索",
              class: "bg-amber-500 hover:bg-amber-400 text-black font-bold px-6 py-2.5 text-sm cursor-pointer tracking-wide transition-colors" %>
        <% if params[:search].present? || params[:genre].present? %>
          <%= link_to "× クリア", posts_path, class: "text-zinc-500 hover:text-zinc-300 text-sm transition-colors whitespace-nowrap" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# ── レコードグリッド ── %>
  <% if @posts.any? %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
      <% @posts.each do |post| %>
        <div class="group bg-zinc-900 border border-zinc-800 overflow-hidden hover:-translate-y-1 transition-all duration-300 ease-out hover:shadow-[0_0_32px_rgba(245,158,11,0.4),0_8px_24px_rgba(245,158,11,0.2)]">
          <%= link_to post, class: "block" do %>
            <div class="aspect-square bg-zinc-800 overflow-hidden relative">
              <% if post.image.attached? %>
                <%= image_tag post.image, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center">
                  <div class="text-center">
                    <div class="w-14 h-14 rounded-full border-2 border-zinc-600 mx-auto mb-2 flex items-center justify-center">
                      <div class="w-3.5 h-3.5 rounded-full bg-zinc-600"></div>
                    </div>
                    <span class="text-zinc-600 text-[11px] tracking-widest uppercase">No Image</span>
                  </div>
                </div>
              <% end %>
            </div>
            <div class="p-3">
              <p class="text-white text-sm font-semibold truncate leading-snug"><%= post.title %></p>
              <p class="text-zinc-400 text-xs mt-0.5 truncate"><%= post.artist %></p>
              <% if post.genre.present? %>
                <span class="inline-block mt-2 text-[10px] px-2 py-0.5 border border-zinc-700 text-amber-400 tracking-wide"><%= post.genre %></span>
              <% end %>
            </div>
          <% end %>
          <div class="px-3 pb-3 flex gap-3 border-t border-zinc-800 pt-2">
            <%= link_to "編集", edit_post_path(post), class: "text-zinc-500 hover:text-amber-400 text-xs transition-colors" %>
            <%= button_to "削除", post,
                  method: :delete,
                  data: { turbo_confirm: t('common.confirm_delete') },
                  class: "!bg-transparent !border-0 !p-0 text-zinc-500 hover:text-red-400 text-xs transition-colors cursor-pointer" %>
          </div>
        </div>
      <% end %>
    </div>

  <%# ── 空の状態 ── %>
  <% else %>
    <div class="border border-dashed border-zinc-800 py-24 text-center">
      <div class="w-20 h-20 rounded-full border-2 border-zinc-700 mx-auto mb-5 flex items-center justify-center">
        <div class="w-5 h-5 rounded-full bg-zinc-700"></div>
      </div>
      <h2 class="text-zinc-200 text-xl font-semibold mb-2">
        <%= params[:search].present? || params[:genre].present? ? "条件に合う盤が見つかりませんでした" : "コレクションがまだありません" %>
      </h2>
      <p class="text-zinc-600 text-sm mb-8">お気に入りのレコードを登録して、自分だけのデータベースを作りましょう。</p>
      <%= link_to "最初の1枚を登録する", new_post_path,
            class: "inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-black font-bold px-6 py-3 text-sm tracking-wide transition-colors" %>
    </div>
  <% end %>

  <%# ── ページネーション ── %>
  <div class="mt-10">
    <%= paginate @posts %>
  </div>

</div>
